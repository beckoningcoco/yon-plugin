{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    // Sources spell relative imports with their `.ts` extension and the compiler
    // rewrites them to `.js` on emit — the same convention the harness uses, so
    // one source tree serves both the type check and the emitted host half.
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  // `preview` is here, not in tsconfig.lib.json: it is the render harness, it is
  // never emitted, and it is the surface most likely to rot silently — five panels'
  // worth of fixtures and mock signatures that nothing else imports. Leaving it
  // outside the gate meant ~90 KB of new code that only a human could notice going
  // wrong; measured at the time of adding it, the whole preview tree was already
  // clean, so this costs nothing today.
  "include": ["src", "tests", "preview", "preview.config.ts"]
}
